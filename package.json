{
  "name": "transwebquick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --format=esm --target=safari17 --outfile=dist/client.js",
    "dev": "npm run build && node --env-file-if-exists=.env --experimental-strip-types src/server/app.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
